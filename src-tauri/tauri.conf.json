{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TUL Writer",
  "version": "0.2.0",
  "identifier": "cz.tulwriter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TUL Writer",
        "width": 1400,
        "height": 860,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../LICENSE": "licenses/TUL-Writer-MIT.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/dependencies/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MzZCOURGQ0E4QTk2QzIKUldUQ2xvckszN2syWnRsa2NZUk5qV3V4V29YU005NllKaEZRQUQ4aFJUNWdUNU1qN2tUTDdqOG0K",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
